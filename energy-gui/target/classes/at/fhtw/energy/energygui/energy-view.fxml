<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="at.fhtw.energy.energygui.EnergyGuiController"
      style="-fx-background-color: #1a1a2e;"
      prefWidth="800" prefHeight="650">

    <!-- Header -->
    <HBox style="-fx-background-color: #16213e; -fx-padding: 15 20 15 20;">
        <Label text="⚡ Energy Community Monitor"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>
    </HBox>

    <!-- Content -->
    <VBox spacing="15" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">

        <!-- Aktueller Status Card -->
        <VBox style="-fx-background-color: #16213e; -fx-padding: 15; -fx-background-radius: 8;">
            <Label text="AKTUELLER STATUS"
                   style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>

            <HBox spacing="30" style="-fx-padding: 10 0 5 0;">
                <VBox spacing="3">
                    <Label text="Community Pool"
                           style="-fx-font-size: 11; -fx-text-fill: #8892b0;"/>
                    <Label fx:id="lblCommunityPool" text="-"
                           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #64ffda;"/>
                </VBox>
                <VBox spacing="3">
                    <Label text="Grid Portion"
                           style="-fx-font-size: 11; -fx-text-fill: #8892b0;"/>
                    <Label fx:id="lblGridPortion" text="-"
                           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #f7931a;"/>
                </VBox>
            </HBox>

            <Label fx:id="lblLastUpdate" text="-"
                   style="-fx-font-size: 10; -fx-text-fill: #8892b0;"/>

            <Button text="↻  Refresh" onAction="#onRefresh"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 4; -fx-padding: 8 16; -fx-cursor: hand;"
                    maxWidth="120"/>
        </VBox>

        <!-- Historische Daten Card -->
        <VBox style="-fx-background-color: #16213e; -fx-padding: 15; -fx-background-radius: 8;"
              VBox.vgrow="ALWAYS">

            <Label text="HISTORISCHE DATEN"
                   style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>

            <HBox spacing="15" style="-fx-padding: 10 0 10 0;" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Start" style="-fx-font-size: 11; -fx-text-fill: #8892b0;"/>
                    <DatePicker fx:id="startPicker" prefWidth="160"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="End" style="-fx-font-size: 11; -fx-text-fill: #8892b0;"/>
                    <DatePicker fx:id="endPicker" prefWidth="160"/>
                </VBox>
                <VBox>
                    <Label text=" " style="-fx-font-size: 11;"/>
                    <Button text="Anzeigen" onAction="#onShowData"
                            style="-fx-background-color: #0f3460; -fx-text-fill: #64ffda;
                                   -fx-font-weight: bold; -fx-background-radius: 4;
                                   -fx-padding: 8 16; -fx-cursor: hand;
                                   -fx-border-color: #64ffda; -fx-border-radius: 4;"/>
                </VBox>
            </HBox>

            <!-- Karten ScrollPane -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #0f3460; -fx-background-color: #0f3460;
                               -fx-border-color: transparent;">
                <FlowPane fx:id="flowHistorical" hgap="10" vgap="10"
                          style="-fx-background-color: #0f3460; -fx-padding: 10;"
                          prefWrapLength="760"/>
            </ScrollPane>

        </VBox>

    </VBox>
</VBox>